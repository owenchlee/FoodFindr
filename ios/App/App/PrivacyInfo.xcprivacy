<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	DRAFT - NOT FINAL. Generated by an agent as a starting scaffold for
	FoodFindr's iOS App Store submission. A human must review every value
	below before this ships - see STATUS.md Phase 6 for what was checked,
	what wasn't, and why.
	-->

	<!-- This app does not track users across other companies' apps/websites
	     for advertising (no ad SDK, no cross-app identifiers). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Used to find/rank nearby restaurants via the Google Places API
		     (server-side call, see server/server.js) and to show distance
		     to the recommended restaurant. Sent to Google as part of that
		     search. Tied to the user's account/session server-side. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Email address, used for account sign-up/login (server/auth.js). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Craving/dish search terms, cuisine and dietary preferences, and
		     group/price/distance filters - sent to the Claude (Anthropic)
		     API server-side to generate a recommendation (server.js
		     /api/recommend). Also used to build the user's taste profile
		     (preferences, flavor tags) stored in the SQLite backend. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeSearchHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!--
	NSPrivacyAccessedAPITypes ("Required Reason API" declarations):
	left EMPTY, not because this was skipped, but because it was actually
	checked - grepped the installed native Swift source for every plugin
	currently in package.json (@capacitor/core's ios/ package, plus
	@capacitor/geolocation and @capacitor/browser, the only two plugins in
	this project) for the signal APIs in Apple's required-reason categories
	(UserDefaults, file-timestamp APIs, disk-space APIs, system-boot-time
	APIs, active-keyboard APIs). None were found in any of the three at the
	versions currently pinned in package-lock.json.

	This is NOT the authoritative check. A human must still open this
	project in Xcode, run Product > Archive, and read the generated privacy
	report (Xcode aggregates required-reason API usage across the FULL
	compiled dependency tree, including anything CocoaPods/SPM pulls in
	transitively that a source grep on this Windows machine can't see or
	build). If that report flags anything, add a dict here with
	NSPrivacyAccessedAPIType set to the flagged category and
	NSPrivacyAccessedAPITypeReasons set to the closest matching reason code
	from Apple's approved list (developer.apple.com/documentation/bundleresources/privacy_manifest_files).
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
